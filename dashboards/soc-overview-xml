<dashboard version="1.1" theme="dark">
  <label>SOC Detection Overview</label>
  <row>
    <panel>
      <title>Detection Totals</title>
      <chart>
        <search>
          <query>index=* (EventCode=4720 OR EventCode=4625 OR (EventCode=1 AND (Image="*\\powershell.exe" OR Image="*\\schtasks.exe")))
| eval Detection=case(EventCode=4720,"Account Created",EventCode=4625,"Failed Logon",like(Image,"%powershell.exe"),"PowerShell",like(Image,"%schtasks.exe"),"Scheduled Task")
| stats count by Detection</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Failed logons (T1110.001)</title>
      <chart>
        <search>
          <query>index=* EventCode=4625
| timechart span=5m count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="charting.chart">column</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Top source of failed logons</title>
      <table>
        <search>
          <query>index=* EventCode=4625
| stats count by Account_Name Source_Network_Address
| sort - count</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>New accounts created (T1136.001)</title>
      <table>
        <search>
          <query>index=* EventCode=4720
| table _time host Account_Name</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Encoded PowerShell (T1059.001)</title>
      <table>
        <search>
          <query>index=* EventCode=1 Image="*\\powershell.exe" (CommandLine="*-enc*" OR CommandLine="*-EncodedCommand*")
| table _time host User CommandLine</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Scheduled tasks created (T1053.005)</title>
      <table>
        <search>
          <query>index=* EventCode=1 Image="*\\schtasks.exe" CommandLine="*/create*"
| table _time host User CommandLine</query>
          <earliest>-24h@h</earliest>
          <latest>now</latest>
        </search>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
</dashboard>
